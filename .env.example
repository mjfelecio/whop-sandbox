NEXT_PUBLIC_WHOP_APP_ID=app_xxxxxxxxxxxxxx
WHOP_API_KEY=whop_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: point the SDK at Whop's sandbox API.
# WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1

# Optional user-token verification overrides supported by @whop/sdk. Normally
# leave both unset so the SDK uses Whop's production JWKS endpoint.
# WHOP_USER_TOKEN_JWKS_URL=https://example.com/.well-known/jwks.json
# WHOP_USER_TOKEN_PUBLIC_KEY={"kty":"EC","crv":"P-256","x":"...","y":"..."}
